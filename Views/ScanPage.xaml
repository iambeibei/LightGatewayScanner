<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             xmlns:vm="clr-namespace:LightGatewayScanner.ViewModels"
             x:Class="LightGatewayScanner.Views.ScanPage"
             x:DataType="vm:ScanViewModel"
             Title="扫码写入"
             BackgroundColor="#F5F6F8">

    <ContentPage.Resources>
        <!-- 结果提示条：浮层与行内兜底共用同一套样式，改配色/字号只改这里 -->
        <Style x:Key="ResultBannerBorder" TargetType="Border">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="ResultBannerLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="White" />
            <!-- 文案固定为三态短句，单行显示，超出时尾部截断而不是换行把浮层撑高 -->
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto"
          RowSpacing="10"
          Padding="12,10,12,14">

        <!-- 顶部标题栏 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Spacing="2">
                <Label Text="储能设备 PN 写入" FontSize="18" FontAttributes="Bold" TextColor="#1B1B1F" />
                <Label Text="{Binding Subtitle}" FontSize="12" TextColor="#6B6B76" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="{Binding ModeButtonText}"
                    Command="{Binding ToggleModeCommand}"
                    Padding="10,6"
                    FontSize="11"
                    BackgroundColor="#EEEDFE"
                    TextColor="#534AB7"
                    CornerRadius="8"
                    VerticalOptions="Center" />
            <Button Grid.Column="2"
                    Text="设置"
                    Command="{Binding OpenSettingsCommand}"
                    Padding="14,8"
                    FontSize="13"
                    BackgroundColor="#512BD4"
                    TextColor="White"
                    CornerRadius="8"
                    VerticalOptions="Center" />
        </Grid>

        <!-- 采集区：API 模式面板（上，按内容高）+ 摄像头预览（下，占剩余空间），两者并存 -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="8">

            <!-- API 模式面板：选老化架 → 选点位（相机保持开启，用来扫储能 PN） -->
            <Border Grid.Row="0"
                    IsVisible="{Binding IsApiMode}"
                    BackgroundColor="White"
                    Stroke="#DCDCE4"
                    StrokeThickness="1"
                    Padding="10,8"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="API 模式：老化架 → 点位（deviceId = 网关 ID）" FontSize="12"
                               FontAttributes="Bold" TextColor="#1B1B1F" VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Button Grid.Column="1" Text="刷新" Command="{Binding LoadRacksCommand}"
                                FontSize="11" Padding="8,4" CornerRadius="6"
                                BackgroundColor="#E6F1FB" TextColor="#185FA5" />
                    </Grid>

                    <!-- 两个下拉框并排：左=老化架，右=点位（联动，先选老化架才有数据） -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="老化架" FontSize="10" TextColor="#6B6B76" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Picker x:Name="RackPicker" Title="请选择" FontSize="13" />
                                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsRackLoading}"
                                                   IsVisible="{Binding IsRackLoading}" Color="#512BD4"
                                                   VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="点位（层号+序号）" FontSize="10" TextColor="#6B6B76" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <Picker x:Name="PointPicker" Title="先选老化架" FontSize="13" />
                                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsPointLoading}"
                                                   IsVisible="{Binding IsPointLoading}" Color="#512BD4"
                                                   VerticalOptions="Center" />
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="{Binding RackHint}" FontSize="11" TextColor="#3B6D11"
                           IsVisible="{Binding RackHint, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding RackError}" FontSize="11" TextColor="#A32D2D"
                           IsVisible="{Binding RackError, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Button Text="重试加载老化架" Command="{Binding LoadRacksCommand}"
                            IsVisible="{Binding RackError, Converter={StaticResource StringToBoolConverter}}"
                            FontSize="11" Padding="8,4" CornerRadius="6" HorizontalOptions="Start"
                            BackgroundColor="#FCEBEB" TextColor="#A32D2D" />

                    <Label Text="{Binding PointHint}" FontSize="11" TextColor="#3B6D11"
                           IsVisible="{Binding PointHint, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Label Text="{Binding PointError}" FontSize="11" TextColor="#A32D2D"
                           IsVisible="{Binding PointError, Converter={StaticResource StringNotEmptyConverter}}" />
                    <Button Text="重试加载点位" Command="{Binding LoadPointsCommand}"
                            IsVisible="{Binding PointError, Converter={StaticResource StringToBoolConverter}}"
                            FontSize="11" Padding="8,4" CornerRadius="6" HorizontalOptions="Start"
                            BackgroundColor="#FCEBEB" TextColor="#A32D2D" />
                </VerticalStackLayout>
            </Border>

            <!-- 未配置储能设备字符串前缀提示 -->
            <Border Grid.Row="1"
                    IsVisible="{Binding IsConfigured, Converter={StaticResource InvertedBoolConverter}}"
                    BackgroundColor="#FCEBEB"
                    Stroke="#A32D2D"
                    StrokeThickness="1"
                    Padding="12"
                    VerticalOptions="Start">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ConfigHint}" FontSize="13" TextColor="#791F1F" />
                    <Button Text="前往设置" Command="{Binding OpenSettingsCommand}"
                            BackgroundColor="#A32D2D" TextColor="White" CornerRadius="8"
                            HorizontalOptions="Start" Padding="16,8" FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <!-- 摄像头预览 -->
            <Border Grid.Row="1"
                    IsVisible="{Binding CameraVisible}"
                    MinimumHeightRequest="160"
                    Stroke="#C8C8D0"
                    StrokeThickness="1"
                    Padding="0"
                    BackgroundColor="#1B1B1F">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid RowDefinitions="*,Auto">
                    <!-- 相机器件由代码动态创建/销毁，关闭时才能真正释放摄像头 -->
                    <ContentView x:Name="CameraHost" Grid.Row="0" />

                    <!-- 提交结果浮层：叠在预览底部，不参与布局测量，所以不会压缩画面；
                         InputTransparent 让点击穿透，不影响下方工具条按钮 -->
                    <Border Grid.Row="0"
                            Style="{StaticResource ResultBannerBorder}"
                            BackgroundColor="{Binding ResultColor}"
                            IsVisible="{Binding ResultOverlayVisible}"
                            InputTransparent="True"
                            ZIndex="10"
                            Margin="8"
                            HorizontalOptions="Fill"
                            VerticalOptions="End">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding ResultText}" Style="{StaticResource ResultBannerLabel}" />
                    </Border>

                    <HorizontalStackLayout Grid.Row="1" Spacing="8" Padding="8" BackgroundColor="#2A2A32">
                        <Button x:Name="TorchButton" Text="照明" Clicked="OnTorchClicked"
                                Padding="14,6" FontSize="12" CornerRadius="6"
                                BackgroundColor="#3A3A44" TextColor="White" />
                        <Button x:Name="CameraToggleButton" Text="{Binding CameraButtonText}" Clicked="OnCameraToggleClicked"
                                Padding="14,6" FontSize="12" CornerRadius="6"
                                BackgroundColor="#3A3A44" TextColor="White" />
                        <Button Text="手动输入" Command="{Binding ManualInputCommand}"
                                Padding="14,6" FontSize="12" CornerRadius="6"
                                BackgroundColor="#3A3A44" TextColor="White" />
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- 扫码结果卡片 -->
        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Border BackgroundColor="White" Stroke="#DCDCE4" StrokeThickness="1" Padding="12,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#E6F1FB" Padding="8,4" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Label Text="网关 ID" FontSize="11" TextColor="#185FA5" />
                    </Border>
                    <Label Grid.Column="1"
                           Text="{Binding GatewayDisplay}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1B1B1F"
                           VerticalOptions="Center"
                           LineBreakMode="CharacterWrap" />
                    <Border Grid.Column="2" BackgroundColor="{Binding OnlineColor}" Padding="10,4" StrokeThickness="0"
                            MinimumWidthRequest="62">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Label Text="{Binding OnlineText}" FontSize="12" TextColor="White"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <Border BackgroundColor="White" Stroke="#DCDCE4" StrokeThickness="1" Padding="12,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Grid.Column="0" BackgroundColor="#EEEDFE" Padding="8,4" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6" />
                        </Border.StrokeShape>
                        <Label Text="储能 PN" FontSize="11" TextColor="#534AB7" />
                    </Border>
                    <Label Grid.Column="1"
                           Text="{Binding PnDisplay}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1B1B1F"
                           VerticalOptions="Center"
                           LineBreakMode="CharacterWrap" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- 状态与结果 -->
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding StatusText}" FontSize="14" TextColor="{Binding StatusColor}"
                       VerticalOptions="Center" LineBreakMode="WordWrap" />
                <ActivityIndicator Grid.Column="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   HorizontalOptions="End" Color="#512BD4" />
            </Grid>

            <Label Text="{Binding ArmHint}" FontSize="12" TextColor="#185FA5"
                   IsVisible="{Binding ArmHint, Converter={StaticResource StringNotEmptyConverter}}" />

            <!-- 行内兜底：相机不可见时没有预览可叠，结果条回到这里显示 -->
            <Border Style="{StaticResource ResultBannerBorder}"
                    BackgroundColor="{Binding ResultColor}"
                    IsVisible="{Binding ResultInlineVisible}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Label Text="{Binding ResultText}" Style="{StaticResource ResultBannerLabel}" />
            </Border>
        </VerticalStackLayout>

        <!-- 操作按钮 -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Button Grid.Column="0" Text="扫网关" Command="{Binding ArmGatewayCommand}"
                    Padding="6,14" FontSize="13" BackgroundColor="#E6F1FB" TextColor="#185FA5" CornerRadius="10" />
            <Button Grid.Column="1" Text="扫 PN" Command="{Binding ArmPnCommand}"
                    Padding="6,14" FontSize="13" BackgroundColor="#EEEDFE" TextColor="#534AB7" CornerRadius="10" />
            <Button Grid.Column="2" Text="清空" Command="{Binding ResetCommand}"
                    Padding="6,14" FontSize="13" BackgroundColor="#F1EFE8" TextColor="#5F5E5A" CornerRadius="10" />
            <Button Grid.Column="3" Text="提交" Command="{Binding SubmitNowCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    Padding="6,14" FontSize="13" BackgroundColor="#512BD4" TextColor="White" CornerRadius="10" />
        </Grid>

        <!-- 相机关闭时，用底部独立一行的按钮重新打开预览（扫码模式专属） -->
        <Button Grid.Row="5" Text="{Binding CameraButtonText}" Clicked="OnCameraToggleClicked"
                IsVisible="{Binding ShowCameraToggle}"
                Padding="16,10" FontSize="13" BackgroundColor="#E6F1FB" TextColor="#185FA5" CornerRadius="10" />
    </Grid>
</ContentPage>
