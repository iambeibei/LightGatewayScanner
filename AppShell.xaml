<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LightGatewayScanner.Views"
       x:Class="LightGatewayScanner.AppShell"
       Title="网关扫码写入"
       Shell.BackgroundColor="#512BD4"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarTitleColor="#512BD4"
       Shell.TabBarUnselectedColor="#8A8A94">

    <TabBar>
        <ShellContent Title="扫码"
                      Route="scan"
                      ContentTemplate="{DataTemplate views:ScanPage}" />
        <ShellContent Title="设置"
                      Route="settings"
                      ContentTemplate="{DataTemplate views:SettingsPage}" />
    </TabBar>
</Shell>
